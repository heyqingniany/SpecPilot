{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpecPilot",
  "version": "0.7.2",
  "identifier": "io.specpilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SpecPilot",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "AI technical document reader",
    "icon": ["icons/icon.ico"]
  }
}
